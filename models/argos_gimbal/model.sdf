<?xml version="1.0"?>
<sdf version="1.9">
  <model name="argos_gimbal">
    <pose>0 0 0.18 0 0 0</pose>
    <plugin filename="ArgosCameraControllerPlugin"
        name="ArgosCameraController">
      <command_topic>/argos/camera/zoom/percent</command_topic>
      <zoom_topic>/model/argos_gimbal/sensor/rgb_camera/zoom/cmd_zoom</zoom_topic>
      <min_percent>0</min_percent>
      <max_percent>100</max_percent>
      <min_zoom>1</min_zoom>
      <max_zoom>125</max_zoom>
      <sitl_udp_port>9010</sitl_udp_port>
      <sitl_reply_udp_port>9011</sitl_reply_udp_port>
      <record_command_topic>/argos/camera/record/command</record_command_topic>
      <record_result_topic>/argos/camera/record/result</record_result_topic>
      <capture_directory>/tmp/argos-camera</capture_directory>
      <reference_hfov>2.0</reference_hfov>
    </plugin>
    <link name="base_link">
      <inertial>
        <mass>0.2</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0001</iyy>
          <iyz>0</iyz>
          <izz>0.0001</izz>
        </inertia>
      </inertial>
      <visual name="base_visual">
        <geometry>
          <mesh>
            <uri>model://argos_gimbal/meshes/base_plate.dae</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1</ambient>
          <diffuse>0.1 0.1 0.1</diffuse>
          <specular>0.01 0.01 0.01 1.0</specular>
        </material>
      </visual>
      <collision name="base_collision">
        <pose>0.01 0.075 -0.025 0 0 0</pose>
        <geometry>
          <box>
            <size>0.1 0.05 0.15</size>
          </box>
        </geometry>
      </collision>
    </link>

    <link name="yaw_link">
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>0.00001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00001</iyy>
          <iyz>0</iyz>
          <izz>0.00001</izz>
        </inertia>
      </inertial>
      <visual name="yaw_visual">
        <geometry>
          <mesh>
            <uri>model://argos_gimbal/meshes/yaw_arm.dae</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1</ambient>
          <diffuse>0.1 0.1 0.1</diffuse>
          <specular>0.01 0.01 0.01 1.0</specular>
        </material>
      </visual>
      <collision name="yaw_collision">
        <geometry>
          <mesh>
            <uri>model://argos_gimbal/meshes/yaw_arm.dae</uri>
          </mesh>
        </geometry>
      </collision>
    </link>
    <joint name="yaw_joint" type="revolute">
      <parent>base_link</parent>
      <child>yaw_link</child>
      <axis>
        <xyz>0 1 0</xyz>
        <dynamics>
          <damping>0.01</damping>
        </dynamics>
        <limit>
          <lower>-3.1415926</lower>
          <upper>3.1415926</upper>
        </limit>
      </axis>
      <pose>0.0105 0.065 -0.002 0 0 0</pose>
    </joint>

    <link name="roll_link">
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>0.00001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00001</iyy>
          <iyz>0</iyz>
          <izz>0.00001</izz>
        </inertia>
      </inertial>
      <visual name="roll_visual">
        <geometry>
          <mesh>
            <uri>model://argos_gimbal/meshes/roll_arm.dae</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1</ambient>
          <diffuse>0.1 0.1 0.1</diffuse>
          <specular>0.01 0.01 0.01 1.0</specular>
        </material>
      </visual>
      <collision name="roll_collision">
        <geometry>
          <mesh>
            <uri>model://argos_gimbal/meshes/roll_arm.dae</uri>
          </mesh>
        </geometry>
      </collision>
    </link>
    <joint name="roll_joint" type="revolute">
      <parent>yaw_link</parent>
      <child>roll_link</child>
      <axis>
        <xyz>0 0 1</xyz>
        <dynamics>
          <damping>0.01</damping>
        </dynamics>
        <limit>
          <lower>-3.1415926</lower>
          <upper>3.1415926</upper>
        </limit>
      </axis>
      <pose>0.0099 0.002 -0.05 0 0 0</pose>
    </joint>

    <link name="pitch_link">
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>0.00001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00001</iyy>
          <iyz>0</iyz>
          <izz>0.00001</izz>
        </inertia>
      </inertial>
      <visual name="pitch_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://argos_gimbal/meshes/camera_enclosure.dae</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.4 0.4 0.4</ambient>
          <diffuse>0.4 0.4 0.4</diffuse>
          <specular>0.1 0.1 0.1 1.0</specular>
        </material>
      </visual>
      <collision name="pitch_collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://argos_gimbal/meshes/camera_enclosure.dae</uri>
          </mesh>
        </geometry>
      </collision>
      <visual name="camera_visual">
        <pose>0 0 0.02 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.025</radius>
            <length>0.050</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.4 0.4 0.4</ambient>
          <diffuse>0.4 0.4 0.4</diffuse>
          <specular>0.1 0.1 0.1 1.0</specular>
        </material>
      </visual>
      <collision name="camera_collision">
        <pose>0 0 0.02 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.025</radius>
            <length>0.050</length>
          </cylinder>
        </geometry>
      </collision>
      <sensor name="rgb_camera" type="camera">
        <gz_frame_id>pitch_link</gz_frame_id>
        <pose>0 0 0 -1.57 -1.57 0</pose>
        <camera>
          <horizontal_fov>2.0</horizontal_fov>
          <image>
            <width>1920</width>
            <height>1080</height>
          </image>
          <distortion>
            <k1>0</k1>
            <k2>0</k2>
            <k3>0</k3>
            <p1>0</p1>
            <p2>0</p2>
            <center>0.5 0.5</center>
          </distortion>
          <clip>
            <near>0.05</near>
            <far>15000</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>1</visualize>

        <plugin filename="CameraZoomPlugin"
            name="CameraZoomPlugin">
          <topic>/model/argos_gimbal/sensor/rgb_camera/zoom/cmd_zoom</topic>
          <max_zoom>125.0</max_zoom>
          <slew_rate>0.42514285714</slew_rate>
        </plugin>

        <plugin name="GstCameraPlugin"
            filename="GstCameraPlugin">
          <udp_host>127.0.0.1</udp_host>
          <udp_port>5600</udp_port>
          <use_basic_pipeline>true</use_basic_pipeline>
          <use_cuda>false</use_cuda>
          <start_streaming>true</start_streaming>
          <record_command_topic>/argos/camera/record/command</record_command_topic>
          <record_result_topic>/argos/camera/record/result</record_result_topic>
          <recording_directory>/tmp/argos-camera</recording_directory>
          <recording_rate>30</recording_rate>
        </plugin>

      </sensor>
      <sensor name="thermal_camera" type="camera">
        <gz_frame_id>pitch_link</gz_frame_id>
        <pose>0 0.03 0 -1.57 -1.57 0</pose>
        <camera>
          <horizontal_fov>1.0</horizontal_fov>
          <image>
            <width>640</width>
            <height>512</height>
            <format>L_INT8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>15000</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>0</visualize>
      </sensor>
    </link>
    <joint name="pitch_joint" type="revolute">
      <parent>roll_link</parent>
      <child>pitch_link</child>
      <axis>
        <xyz>1 0 0</xyz>
        <dynamics>
          <damping>0.01</damping>
        </dynamics>
        <limit>
          <lower>-3.1415926</lower>
          <upper>3.1415926</upper>
        </limit>
      </axis>
      <pose>0.045 0.0021 0.0199 0 0 0</pose>
    </joint>
  </model>
</sdf>
